<?xml version="1.0" encoding="utf-8"?>
<!-- Copyright Plain Browser contributors. MPL-2.0.
     Strings of //plainbrowser/shields: the toolbar button, its bubble and the
     exception list in Settings > Privacy and security. Part of
     chrome/app/generated_resources.grd (patches/60-ui/0008), so the IDS_ ids
     are in chrome/grit/generated_resources.h. Translations:
     plainbrowser_shields_strings_<lang>.xtb next to this file, listed in the
     same grd; ids are grit's message fingerprints, see README.md here. Every message has
     the same meaning attribute: it is part of the fingerprint, so our ids never
     collide with a Chromium message of the same English text (grit asserts on
     a second translation of one id). -->
<grit-part>
  <!-- Toolbar button. -->
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_SHIELDS_BUTTON_NAME" desc="Accessible name and tooltip of the Plain Browser protections button in the toolbar, when the current page is not a website.">
    Plain Browser protections
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_SHIELDS_TOOLTIP_ON" desc="Tooltip of the Plain Browser protections button when protections are on for the website in the current tab.">
    Plain Browser protections: on for <ph name="SITE">$1<ex>example.com</ex></ph>
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_SHIELDS_TOOLTIP_OFF" desc="Tooltip of the Plain Browser protections button when the user turned protections off for the website in the current tab.">
    Plain Browser protections: off for <ph name="SITE">$1<ex>example.com</ex></ph>
  </message>

  <!-- Bubble under the button. -->
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_SHIELDS_THIS_PAGE" desc="Shown in the protections bubble instead of a site name when the current page is not a website (for example a settings page).">
    This page
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_SHIELDS_TOGGLE" desc="Label of the on/off switch in the protections bubble. On means ad blocking, tracking-parameter stripping and fingerprint protection apply to the current website.">
    Protections on for this site
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_SHIELDS_NOT_APPLICABLE" desc="Status line in the protections bubble when the current page is not a website.">
    Protections do not apply to this page.
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_SHIELDS_RELOADING_ON" desc="Status line in the protections bubble right after the user turned protections back on; the page reloads.">
    Protections on. The page is reloading.
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_SHIELDS_RELOADING_OFF" desc="Status line in the protections bubble right after the user turned protections off for the site; the page reloads.">
    Protections off for this site. The page is reloading.
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_SHIELDS_OFF_STATUS" desc="Status line in the protections bubble when protections are off for the current website.">
    Ad blocking, tracking-parameter stripping and fingerprint protection are off for this site.
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_SHIELDS_BLOCKED_COUNT" desc="Status line in the protections bubble and accessible description of the toolbar button: how many network requests (ads, trackers) were blocked on the page in the current tab.">
    {COUNT, plural, =0 {No requests blocked on this page.} =1 {1 request blocked on this page.} other {# requests blocked on this page.}}
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_SHIELDS_MANAGE" desc="Link in the protections bubble that opens the list of all sites with protections off, in Settings.">
    Manage sites
  </message>

  <!-- Settings > Privacy and security. -->
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_SHIELDS_TITLE" desc="Heading of the list of sites on which the user turned Plain Browser protections off, on the Privacy and security settings page.">
    Sites with protections off
  </message>
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_SHIELDS_DESC" desc="Description under the heading of the list of sites with Plain Browser protections off.">
    Ad blocking, tracking-parameter stripping and fingerprint protection are off on these sites, including their subdomains. You can also turn them off for the current site with the shield button next to the address bar.
  </message>
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_SHIELDS_EMPTY" desc="Shown in place of the list when no site has Plain Browser protections off.">
    No sites added
  </message>
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_SHIELDS_ADD" desc="Button that opens a dialog to add a site to the list of sites with Plain Browser protections off; also the confirm button of that dialog.">
    Add
  </message>
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_SHIELDS_ADD_TITLE" desc="Title of the dialog in which the user types a site to turn Plain Browser protections off for.">
    Turn protections off for a site
  </message>
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_SHIELDS_SITE_LABEL" desc="Label of the text field in the add-site dialog.">
    Site
  </message>
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_SHIELDS_INVALID" desc="Error under the text field in the add-site dialog when the text is not a website address.">
    Enter a site, for example example.com
  </message>
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_SHIELDS_REMOVE" desc="Tooltip and accessible name of the button that removes a site from the list of sites with Plain Browser protections off (protections turn back on for it).">
    Turn protections back on for <ph name="SITE">$1<ex>example.com</ex></ph>
  </message>
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_LIST_UPDATES" desc="Label of the toggle on the Privacy and security settings page that turns daily downloads of updated ad and tracker filter lists on or off.">
    Update filter lists daily
  </message>
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_LIST_UPDATES_DESC" desc="Description under the filter list update toggle: where the lists come from and what is sent.">
    Downloads new versions of EasyList, EasyPrivacy, EasyList Polish and the lists turned on above from lists.plain-browser.app. The request carries no cookies and nothing about the sites you visit. When off, the lists the browser was released with are used.
  </message>

  <!-- Global switch, last check and the status page link (settings). -->
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_BLOCKING" desc="Label of the toggle on the Privacy and security settings page that turns Plain Browser's ad and tracker blocking on or off for all sites.">
    Block ads and trackers
  </message>
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_BLOCKING_DESC" desc="Description under the ad and tracker blocking toggle in settings: which lists are used and what the toggle does not cover.">
    Uses EasyList, EasyPrivacy and EasyList Polish on every site except the ones listed below. Removing tracking parameters from links stays on.
  </message>
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_LIST_LAST_CHECK" desc="Shown under the filter list update toggle in settings and on chrome://adblock: when the browser last confirmed its ad and tracker filter lists are current.">
    Lists last checked: <ph name="TIME">$1<ex>28 Oct 2026, 09:12</ex></ph>
  </message>
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_LIST_NEVER_CHECKED" desc="Shown under the filter list update toggle in settings and on chrome://adblock when the browser has not yet checked for updated filter lists.">
    Lists not checked yet
  </message>
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_ADBLOCK_STATUS" desc="Label of the settings row that opens the ad blocker status page (chrome://adblock).">
    Ad blocker status
  </message>
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_ADBLOCK_STATUS_DESC" desc="Description of the settings row that opens the ad blocker status page.">
    Filter lists in use, the filter engine and blocked requests
  </message>
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_LIST_COOKIE" desc="Label of a settings toggle under Block ads and trackers: use the EasyList Cookie List.">
    Hide cookie consent banners
  </message>
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_LIST_COOKIE_DESC" desc="Description under the cookie banner toggle.">
    Uses the EasyList Cookie List. Hiding a banner does not accept or reject cookies; third-party cookies stay blocked either way.
  </message>
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_LIST_ANNOYANCE" desc="Label of a settings toggle under Block ads and trackers: use Fanboy's Annoyance List.">
    Block annoyances
  </message>
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_LIST_ANNOYANCE_DESC" desc="Description under the annoyances toggle.">
    Uses Fanboy's Annoyance List: pop-ups, newsletter and notification prompts, social media buttons and cookie banners. May hide things some sites need.
  </message>
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_LIST_UBLOCK" desc="Label of a settings toggle under Block ads and trackers: use uBlock Origin's own filter list.">
    Use uBlock filters
  </message>
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_LIST_UBLOCK_DESC" desc="Description under the uBlock filters toggle.">
    Adds uBlock Origin's own list, which catches more ads and trackers. Some of its rules need uBlock Origin itself and are skipped.
  </message>
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_EXTENSIONS" desc="Label of a settings row that opens the page of extensions Plain Browser hosts.">
    Recommended extensions
  </message>
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_EXTENSIONS_DESC" desc="Description of the settings row that opens the recommended extensions page.">
    uBlock Origin, AdGuard, NoScript and uMatrix, installed and updated from Plain Browser
  </message>

  <!-- chrome://adblock -->
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_PAGE_TITLE" desc="Title of the chrome://adblock page, which shows the state of Plain Browser's ad blocker.">
    Ad blocker
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_BLOCKING" desc="Row label on chrome://adblock: whether ad and tracker blocking is on.">
    Ad and tracker blocking
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_ON" desc="Value on chrome://adblock when ad and tracker blocking is turned on.">
    On
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_OFF" desc="Value on chrome://adblock when ad and tracker blocking is turned off.">
    Off
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_BLOCKED" desc="Row label on chrome://adblock next to a number: requests the ad blocker blocked since the browser was started.">
    Requests blocked since the browser started
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_ENGINE" desc="Row label on chrome://adblock: the state of the filter engine, which runs in a separate process.">
    Filter engine
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_ENGINE_RUNNING" desc="State of the filter engine on chrome://adblock: its process is running.">
    Running in its own sandboxed process
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_ENGINE_IDLE" desc="State of the filter engine on chrome://adblock: its process is not running yet and starts when a page needs it.">
    Starts with the next page
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_ENGINE_STOPPED" desc="State of the filter engine on chrome://adblock after its process crashed several times and the browser stopped restarting it.">
    Stopped after repeated crashes. Nothing is blocked until you restart the browser.
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_ENGINE_STARTS" desc="Under the filter engine state on chrome://adblock: how many times its process was started in this browser session.">
    Process starts this session: <ph name="COUNT">$1<ex>1</ex></ph>
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_LISTS" desc="Section heading on chrome://adblock: the ad and tracker filter lists in use.">
    Filter lists
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_LIST_DOWNLOADED" desc="Under a filter list name on chrome://adblock: the list in use is a newer copy downloaded from the project's server.">
    Updated copy from lists.plain-browser.app
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_LIST_BUNDLED" desc="Under a filter list name on chrome://adblock: the list in use is the one shipped with this browser version.">
    Built into this version
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_UPDATES" desc="Section heading on chrome://adblock: daily updates of the filter lists.">
    Updates
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_UPDATES_OFF" desc="Shown on chrome://adblock when the user turned daily filter list updates off in settings.">
    Daily updates are off
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_LAST_FAILED" desc="Shown on chrome://adblock when the last attempt to check for updated filter lists failed.">
    The last check failed. The browser tries again within an hour.
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_CHECK_NOW" desc="Button on chrome://adblock that checks for updated filter lists right away.">
    Check now
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_CHECKING" desc="Button text on chrome://adblock while a check for updated filter lists is running.">
    Checking…
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_SETTINGS" desc="Link on chrome://adblock to the browser's privacy settings.">
    Settings
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_LIST_OFF" desc="Under a filter list name on chrome://adblock: an optional list the user has not turned on.">
    Off
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_LISTS_NOTE" desc="Note under the filter lists on chrome://adblock: where the optional lists are turned on.">
    Cookie banners, annoyances and uBlock filters are turned on or off in Settings.
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_CUSTOM_FILTERS" desc="Section heading on chrome://adblock: the user's own filter rules.">
    My filters
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_CUSTOM_FILTERS_DESC" desc="Explanation above the text box for the user's own filter rules on chrome://adblock.">
    Your own rules in Adblock Plus or uBlock Origin syntax, one per line. They apply on top of the lists; a rule starting with @@ allows what a list blocks.
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_SAVE" desc="Button on chrome://adblock that saves the user's own filter rules.">
    Save
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_SAVED" desc="Shown on chrome://adblock after the user's own filter rules were saved.">
    Saved. The filters apply in a moment.
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_SAVE_FAILED" desc="Shown on chrome://adblock when the user's own filter rules could not be saved.">
    Not saved: the text is too long (at most 1 MB).
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_LOG" desc="Section heading on chrome://adblock: a list of requests the blocker acted on.">
    Request log
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_LOG_DESC" desc="Explanation of the request log on chrome://adblock: what it records and for how long.">
    What the blocker did in any tab while this page is open, newest first. Kept in memory only and cleared when you close the page.
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_LOG_EMPTY" desc="Shown on chrome://adblock when the request log has no entries.">
    Nothing yet. Load a page in another tab.
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_LOG_FILTER" desc="Placeholder of the search box that filters the request log on chrome://adblock.">
    Filter by address
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_LOG_CLEAR" desc="Button on chrome://adblock that empties the request log.">
    Clear
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_LOG_BLOCKED" desc="Label of a request log entry: a network request was blocked.">
    Blocked
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_LOG_REDIRECTED" desc="Label of a request log entry: a request was answered with a harmless stand-in resource.">
    Replaced
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_LOG_PARAMS" desc="Label of a request log entry: tracking parameters were removed from a link.">
    Parameters removed
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_ADBLOCK_LOG_DEBOUNCED" desc="Label of a request log entry: a tracking redirect page was skipped.">
    Redirect skipped
  </message>

  <!-- chrome://recommended-extensions (//plainbrowser/extensions). -->
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_EXTENSIONS_TITLE" desc="Title of chrome://recommended-extensions.">
    Recommended extensions
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_EXTENSIONS_INTRO" desc="Introduction on chrome://recommended-extensions.">
    Extensions that Plain Browser hosts and keeps up to date, since the Chrome Web Store is not part of this browser. Each one is the developer's release, unchanged except for where it gets its updates from.
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_EXTENSIONS_INSTALL" desc="Button that installs an extension on chrome://recommended-extensions.">
    Install
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_EXTENSIONS_INSTALLING" desc="Disabled button text while an extension is being downloaded or installed.">
    Installing…
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_EXTENSIONS_ENABLED" desc="State of an installed extension on chrome://recommended-extensions.">
    Installed
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_EXTENSIONS_DISABLED" desc="State of an installed but turned-off extension on chrome://recommended-extensions.">
    Installed, turned off
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_EXTENSIONS_FROM_STORE" desc="Note under an extension that was installed from the Chrome Web Store.">
    Installed from the Chrome Web Store, which no longer updates it here.
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_EXTENSIONS_SWITCH" desc="Button that replaces a Chrome Web Store copy of an extension with Plain Browser's.">
    Switch
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_EXTENSIONS_SWITCH_DESC" desc="Explains the Switch button on chrome://recommended-extensions.">
    Switch installs Plain Browser's copy, takes over its settings and removes the old one.
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_EXTENSIONS_UNMAINTAINED" desc="Tag on an extension whose developer stopped working on it.">
    No longer developed
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_EXTENSIONS_MANIFEST_V3" desc="Tag on an extension built on Manifest V3 rather than V2.">
    Manifest V3
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_EXTENSIONS_SOURCE" desc="Link to an extension's source code and project page.">
    Source code
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_EXTENSIONS_MANAGE" desc="Link from chrome://recommended-extensions to chrome://extensions.">
    Manage extensions
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_EXTENSIONS_BOTH_BLOCKERS" desc="Shown when an ad blocking extension runs next to the built-in ad blocker. NAME is the extension.">
    <ph name="NAME">$1<ex>uBlock Origin</ex></ph> blocks ads too. With the built-in blocker also on, every request is filtered twice. Turn the built-in blocker off? Removing tracking parameters stays on.
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_EXTENSIONS_TURN_OFF_BUILT_IN" desc="Button that turns off the built-in ad blocker.">
    Turn off built-in blocker
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_EXTENSIONS_KEEP_BOTH" desc="Button that keeps both the extension and the built-in ad blocker on.">
    Keep both
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_EXTENSIONS_BUILT_IN_OFF" desc="Added to the introduction when the built-in ad blocker is off.">
    The built-in ad blocker is off.
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_EXTENSIONS_OTHER" desc="Text above the link to chrome://extensions.">
    Other extensions can be installed from a .crx file: open it and confirm the dialog. Manifest V2 extensions keep working in Plain Browser.
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_EXTENSIONS_DOWNLOAD_FAILED" desc="Error under an extension when its download failed.">
    Download failed. Check your connection and try again.
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_EXTENSIONS_UBLOCK_DESC" desc="Description of uBlock Origin on chrome://recommended-extensions.">
    Ad and tracker blocker with full control: its own lists, an element picker, a request logger and per-site rules.
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_EXTENSIONS_ADGUARD_DESC" desc="Description of AdGuard on chrome://recommended-extensions.">
    Ad blocker with its own filter lists, including regional ones, and a stealth mode against tracking.
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_EXTENSIONS_NOSCRIPT_DESC" desc="Description of NoScript on chrome://recommended-extensions.">
    Runs JavaScript only on sites you trust, with protection against cross-site scripting.
  </message>
  <message meaning="Plain Browser shields" name="IDS_PLAINBROWSER_EXTENSIONS_UMATRIX_DESC" desc="Description of uMatrix on chrome://recommended-extensions.">
    A matrix of what each site may load: scripts, frames, cookies and more, per domain. For advanced users.
  </message>

  <!-- About page (chrome://settings/help). -->
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_ABOUT_BASE" desc="Line on the About page: which Chromium and ungoogled-chromium versions this browser is built from.">
    Based on Chromium <ph name="CHROMIUM_VERSION">$1<ex>157.0.8103.38</ex></ph> and ungoogled-chromium <ph name="UNGOOGLED_VERSION">$2<ex>157.0.8103.38-1.1</ex></ph>
  </message>
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_ABOUT_COMPONENTS" desc="Line on the About page: the ad blocking component and the filter lists built into this browser.">
    Ad blocking: adblock-rust <ph name="ADBLOCK_VERSION">$1<ex>0.13.3</ex></ph> with the EasyList, EasyPrivacy and EasyList Polish filter lists, and optionally the EasyList Cookie List, Fanboy's Annoyance List and uBlock filters
  </message>

  <!-- Safe Browsing through the Plain Browser proxy (patches/70-safebrowsing/0005,
       //plainbrowser/safebrowsing/ui). The last two replace Chromium's
       descriptions on the Security page. -->
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_SAFEBROWSING_PROXY" desc="Label of the Safe Browsing toggle on the Google services page">
    Safe Browsing through the Plain Browser proxy
  </message>
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_SAFEBROWSING_PROXY_DESC" desc="Description of the Safe Browsing toggle on the Google services page">
    Checks the sites you visit against a local copy of Google's Safe Browsing list. The list updates go through sb.plain-browser.app, so Google does not see your IP address or the sites you visit.
  </message>
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_SAFEBROWSING_STANDARD_DESC" desc="Description for safe browsing standard protection mode (replaces Chromium's)">
    Protects against sites, downloads, and extensions that are known to be dangerous. The check runs against a list stored on your device; the list updates go through the Plain Browser proxy, so Google does not see your IP address or the sites you visit. The list is Google's Safe Browsing data; its accuracy and reliability cannot be guaranteed.
  </message>
  <message meaning="Plain Browser shields" name="IDS_SETTINGS_PLAINBROWSER_SAFEBROWSING_NONE_DESC" desc="Description for safe browsing no protection mode (replaces Chromium's)">
    Does not protect you against dangerous websites, downloads, and extensions. The browser then makes no Safe Browsing requests at all.
  </message>
</grit-part>
