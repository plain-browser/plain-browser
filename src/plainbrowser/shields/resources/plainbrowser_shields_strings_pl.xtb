<!DOCTYPE translationbundle>
<translationbundle lang="pl">
<!-- Polish translations of plainbrowser_shields_strings.grdp. Ids: scripts/grit-ids.py (README.md here). -->
<translation id="7880046913804588843">Ochrona Plain Browser</translation>
<translation id="7588071554616981613">Ochrona Plain Browser: włączona dla <ph name="SITE" /></translation>
<translation id="6448422203278305934">Ochrona Plain Browser: wyłączona dla <ph name="SITE" /></translation>
<translation id="4908847314368827524">Ta strona</translation>
<translation id="1808069800901032026">Ochrona włączona na tej witrynie</translation>
<translation id="4725278459588685576">Ochrona nie dotyczy tej strony.</translation>
<translation id="888390145648876817">Ochrona włączona. Strona wczytuje się ponownie.</translation>
<translation id="3842738817138805688">Ochrona wyłączona na tej witrynie. Strona wczytuje się ponownie.</translation>
<translation id="5891082244763309562">Blokowanie reklam, usuwanie parametrów śledzących i ochrona przed fingerprintingiem są wyłączone na tej witrynie.</translation>
<translation id="2548172275515237691">{COUNT, plural, =0 {Na tej stronie nie zablokowano żadnych żądań.} =1 {Na tej stronie zablokowano 1 żądanie.} few {Na tej stronie zablokowano # żądania.} many {Na tej stronie zablokowano # żądań.} other {Na tej stronie zablokowano # żądania.}}</translation>
<translation id="2663829518985069677">Zarządzaj witrynami</translation>
<translation id="7707383106945981379">Witryny z wyłączoną ochroną</translation>
<translation id="8504326310948201892">Blokowanie reklam, usuwanie parametrów śledzących i ochrona przed fingerprintingiem są wyłączone na tych witrynach, także w ich subdomenach. Ochronę bieżącej witryny możesz też wyłączyć przyciskiem z tarczą obok paska adresu.</translation>
<translation id="7676722686617519425">Nie dodano żadnych witryn</translation>
<translation id="6902994320933381569">Dodaj</translation>
<translation id="938113090818501241">Wyłącz ochronę dla witryny</translation>
<translation id="6284400030989800663">Witryna</translation>
<translation id="2695417193754801563">Wpisz witrynę, na przykład example.com</translation>
<translation id="7140235993367976388">Włącz ponownie ochronę dla <ph name="SITE" /></translation>
<translation id="7814110254042078847">Aktualizuj listy filtrów codziennie</translation>
<translation id="765175208110084570">Pobiera nowe wersje EasyList, EasyPrivacy, EasyList Polish i list włączonych powyżej z lists.plain-browser.app. Żądanie nie zawiera plików cookie ani niczego o odwiedzanych stronach. Po wyłączeniu używane są listy z dnia wydania przeglądarki.</translation>
<translation id="4447472862672033345">Blokuj reklamy i elementy śledzące</translation>
<translation id="5627923160287742480">Korzysta z list EasyList, EasyPrivacy i EasyList Polish na wszystkich stronach poza wymienionymi niżej. Usuwanie parametrów śledzących z linków działa nadal.</translation>
<translation id="7203308747385151463">Ostatnie sprawdzenie list: <ph name="TIME" /></translation>
<translation id="9073694362117505155">Listy nie zostały jeszcze sprawdzone</translation>
<translation id="4462987915989454691">Stan blokowania reklam</translation>
<translation id="5726250559130241787">Używane listy filtrów, silnik filtrów i zablokowane żądania</translation>
<translation id="3627800004937799608">Blokowanie reklam</translation>
<translation id="5349364349602953602">Blokowanie reklam i elementów śledzących</translation>
<translation id="3153235593584321242">Włączone</translation>
<translation id="3039975352071748087">Wyłączone</translation>
<translation id="2472345140417966096">Żądania zablokowane od uruchomienia przeglądarki</translation>
<translation id="6443860390015525091">Silnik filtrów</translation>
<translation id="2073884568846391675">Działa we własnym procesie w piaskownicy</translation>
<translation id="113447641346053537">Uruchomi się przy następnej stronie</translation>
<translation id="7611443129955377976">Zatrzymany po kolejnych awariach. Do ponownego uruchomienia przeglądarki nic nie jest blokowane.</translation>
<translation id="5292405452235305291">Uruchomienia procesu w tej sesji: <ph name="COUNT" /></translation>
<translation id="353716021151587304">Listy filtrów</translation>
<translation id="4300206372225994814">Aktualna kopia z lists.plain-browser.app</translation>
<translation id="3714293724629759655">Wbudowana w tę wersję</translation>
<translation id="4400672829102797741">Aktualizacje</translation>
<translation id="3764645718320810263">Codzienne aktualizacje są wyłączone</translation>
<translation id="3053476032032536111">Ostatnie sprawdzenie się nie udało. Przeglądarka spróbuje ponownie w ciągu godziny.</translation>
<translation id="6960448024325525076">Sprawdź teraz</translation>
<translation id="2258591756126042219">Sprawdzanie…</translation>
<translation id="8176333615161936429">Ustawienia</translation>
<translation id="1059992045765968998">Oparta na Chromium <ph name="CHROMIUM_VERSION" /> i ungoogled-chromium <ph name="UNGOOGLED_VERSION" /></translation>
<translation id="6276914901180342648">Blokowanie reklam: adblock-rust <ph name="ADBLOCK_VERSION" /> z listami filtrów EasyList, EasyPrivacy i EasyList Polish oraz opcjonalnie EasyList Cookie List, Fanboy's Annoyance List i uBlock filters</translation>
<translation id="3764789922346718224">Bezpieczne przeglądanie przez proxy Plain Browser</translation>
<translation id="2282871240808545722">Sprawdza odwiedzane strony w lokalnej kopii listy Google Safe Browsing. Aktualizacje listy idą przez sb.plain-browser.app, więc Google nie widzi Twojego adresu IP ani odwiedzanych stron.</translation>
<translation id="4148816261533578642">Chroni przed stronami, pobieranymi plikami i rozszerzeniami, o których wiadomo, że są niebezpieczne. Sprawdzanie odbywa się w liście zapisanej na Twoim urządzeniu; aktualizacje listy idą przez proxy Plain Browser, więc Google nie widzi Twojego adresu IP ani odwiedzanych stron. Lista to dane Google Safe Browsing; nie gwarantujemy ich dokładności ani niezawodności.</translation>
<translation id="7145105833746463623">Nie chroni przed niebezpiecznymi stronami, pobieranymi plikami ani rozszerzeniami. Przeglądarka nie wysyła wtedy żadnych żądań Bezpiecznego przeglądania.</translation>
<translation id="3014839928591948893">Ukrywaj banery zgody na pliki cookie</translation>
<translation id="5448051424413123712">Używa listy EasyList Cookie List. Ukrycie banera nie akceptuje ani nie odrzuca plików cookie; pliki cookie innych firm i tak pozostają zablokowane.</translation>
<translation id="165039196690473565">Blokuj elementy irytujące</translation>
<translation id="6236800420889449753">Używa listy Fanboy's Annoyance List: wyskakujące okienka, prośby o zapis do newslettera i o powiadomienia, przyciski mediów społecznościowych i banery cookie. Może ukryć coś, czego potrzebują niektóre strony.</translation>
<translation id="5878792354718601832">Używaj filtrów uBlock</translation>
<translation id="2841785305420134566">Dodaje własną listę uBlock Origin, która wyłapuje więcej reklam i elementów śledzących. Część jej reguł wymaga samego uBlock Origin i jest pomijana.</translation>
<translation id="9183677069987945187">Polecane rozszerzenia</translation>
<translation id="3357479668854659176">uBlock Origin, AdGuard i NoScript, instalowane i aktualizowane przez Plain Browser</translation>
<translation id="5956302341139390512">Banery cookie, elementy irytujące i filtry uBlock włącza się i wyłącza w Ustawieniach.</translation>
<translation id="3811627340506092408">Moje filtry</translation>
<translation id="8595482019578114552">Własne reguły w składni Adblock Plus lub uBlock Origin, jedna w wierszu. Działają oprócz list; reguła zaczynająca się od @@ zezwala na to, co blokuje lista.</translation>
<translation id="1955467578350760295">Zapisz</translation>
<translation id="217130848514592703">Zapisano. Filtry zaczną działać za chwilę.</translation>
<translation id="3422806511953694379">Nie zapisano: tekst jest za długi (najwyżej 1 MB).</translation>
<translation id="7890748505327403723">Dziennik żądań</translation>
<translation id="2240840760931479807">Co bloker zrobił w dowolnej karcie, gdy ta strona jest otwarta, od najnowszych. Przechowywany tylko w pamięci i czyszczony po zamknięciu strony.</translation>
<translation id="91822384114738763">Na razie nic. Wczytaj stronę w innej karcie.</translation>
<translation id="2343002560135867433">Filtruj po adresie</translation>
<translation id="4605939848565560485">Wyczyść</translation>
<translation id="2675763716987484984">Zablokowano</translation>
<translation id="8029496662359177651">Podmieniono</translation>
<translation id="3602814153219339524">Usunięto parametry</translation>
<translation id="422719653428027673">Pominięto przekierowanie</translation>
<translation id="7525627774898412756">Rozszerzenia, które Plain Browser udostępnia i aktualizuje, bo Chrome Web Store nie jest częścią tej przeglądarki. Każde to wydanie autora, niezmienione poza tym, skąd pobiera aktualizacje.</translation>
<translation id="8122962936394258542">Zainstaluj</translation>
<translation id="5229936127817457063">Instalowanie…</translation>
<translation id="4126605170642698281">Zainstalowane</translation>
<translation id="7816175115292842806">Zainstalowane, wyłączone</translation>
<translation id="7317574540299844403">Zainstalowane z Chrome Web Store, który tutaj go już nie aktualizuje.</translation>
<translation id="9154913973144491487">Przełącz</translation>
<translation id="5389716665491759789">Przełącz instaluje kopię Plain Browser, przejmuje ustawienia i usuwa starą.</translation>
<translation id="7182581833361504953">Nierozwijane</translation>
<translation id="3317893725122710373">Manifest V3</translation>
<translation id="6531921734909666485">Kod źródłowy</translation>
<translation id="7595025823475821933">Zarządzaj rozszerzeniami</translation>
<translation id="866238298842746326"><ph name="NAME" /> też blokuje reklamy. Gdy wbudowany bloker jest również włączony, każde żądanie jest filtrowane dwa razy. Wyłączyć wbudowany bloker? Usuwanie parametrów śledzących pozostanie włączone.</translation>
<translation id="2404425292321051486">Wyłącz wbudowany bloker</translation>
<translation id="923819524560008105">Zostaw oba</translation>
<translation id="7055538184307125368">Wbudowany bloker reklam jest wyłączony.</translation>
<translation id="8492420082959381587">Inne rozszerzenia można zainstalować z pliku .crx: otwórz go i potwierdź okno dialogowe. Rozszerzenia Manifest V2 nadal działają w Plain Browser.</translation>
<translation id="4894827201304571864">Nie udało się pobrać. Sprawdź połączenie i spróbuj ponownie.</translation>
<translation id="865140396727925358">Blokowanie reklam i elementów śledzących z pełną kontrolą: własne listy, wybieranie elementów, dziennik żądań i reguły dla witryn.</translation>
<translation id="6698716151471216779">Bloker reklam z własnymi listami filtrów, także regionalnymi, i trybem ochrony przed śledzeniem.</translation>
<translation id="6157317252121055591">Uruchamia JavaScript tylko na zaufanych stronach, z ochroną przed atakami cross-site scripting.</translation>
</translationbundle>
