<translation id="7880046913804588843">Ochrona Plain Browser</translation>
<translation id="7588071554616981613">Ochrona Plain Browser: włączona dla <ph name="SITE" /></translation>
<translation id="6448422203278305934">Ochrona Plain Browser: wyłączona dla <ph name="SITE" /></translation>
<translation id="4908847314368827524">Ta strona</translation>
<translation id="1808069800901032026">Ochrona włączona na tej witrynie</translation>
<translation id="4725278459588685576">Ochrona nie dotyczy tej strony.</translation>
<translation id="888390145648876817">Ochrona włączona. Strona wczytuje się ponownie.</translation>
<translation id="3842738817138805688">Ochrona wyłączona na tej witrynie. Strona wczytuje się ponownie.</translation>
<translation id="5891082244763309562">Blokowanie reklam, usuwanie parametrów śledzących i ochrona przed fingerprintingiem są wyłączone na tej witrynie.</translation>
<translation id="2548172275515237691">{COUNT, plural, =0 {Na tej stronie nie zablokowano żadnych żądań.} =1 {Na tej stronie zablokowano 1 żądanie.} few {Na tej stronie zablokowano # żądania.} many {Na tej stronie zablokowano # żądań.} other {Na tej stronie zablokowano # żądania.}}</translation>
<translation id="2663829518985069677">Zarządzaj witrynami</translation>
<translation id="7707383106945981379">Witryny z wyłączoną ochroną</translation>
<translation id="8504326310948201892">Blokowanie reklam, usuwanie parametrów śledzących i ochrona przed fingerprintingiem są wyłączone na tych witrynach, także w ich subdomenach. Ochronę bieżącej witryny możesz też wyłączyć przyciskiem z tarczą obok paska adresu.</translation>
<translation id="7676722686617519425">Nie dodano żadnych witryn</translation>
<translation id="6902994320933381569">Dodaj</translation>
<translation id="938113090818501241">Wyłącz ochronę dla witryny</translation>
<translation id="6284400030989800663">Witryna</translation>
<translation id="2695417193754801563">Wpisz witrynę, na przykład example.com</translation>
<translation id="7140235993367976388">Włącz ponownie ochronę dla <ph name="SITE" /></translation>
<translation id="7814110254042078847">Aktualizuj listy filtrów codziennie</translation>
<translation id="7372708730951011360">Pobiera nowe wersje EasyList, EasyPrivacy i EasyList Polish z lists.plain-browser.app. Żądanie nie zawiera plików cookie ani niczego o odwiedzanych stronach. Po wyłączeniu używane są listy z dnia wydania przeglądarki.</translation>
<translation id="4447472862672033345">Blokuj reklamy i elementy śledzące</translation>
<translation id="5627923160287742480">Korzysta z list EasyList, EasyPrivacy i EasyList Polish na wszystkich stronach poza wymienionymi niżej. Usuwanie parametrów śledzących z linków działa nadal.</translation>
<translation id="7203308747385151463">Ostatnie sprawdzenie list: <ph name="TIME" /></translation>
<translation id="9073694362117505155">Listy nie zostały jeszcze sprawdzone</translation>
<translation id="4462987915989454691">Stan blokowania reklam</translation>
<translation id="5726250559130241787">Używane listy filtrów, silnik filtrów i zablokowane żądania</translation>
<translation id="3627800004937799608">Blokowanie reklam</translation>
<translation id="5349364349602953602">Blokowanie reklam i elementów śledzących</translation>
<translation id="3153235593584321242">Włączone</translation>
<translation id="3039975352071748087">Wyłączone</translation>
<translation id="2472345140417966096">Żądania zablokowane od uruchomienia przeglądarki</translation>
<translation id="6443860390015525091">Silnik filtrów</translation>
<translation id="2073884568846391675">Działa we własnym procesie w piaskownicy</translation>
<translation id="113447641346053537">Uruchomi się przy następnej stronie</translation>
<translation id="7611443129955377976">Zatrzymany po kolejnych awariach. Do ponownego uruchomienia przeglądarki nic nie jest blokowane.</translation>
<translation id="5292405452235305291">Uruchomienia procesu w tej sesji: <ph name="COUNT" /></translation>
<translation id="353716021151587304">Listy filtrów</translation>
<translation id="4300206372225994814">Aktualna kopia z lists.plain-browser.app</translation>
<translation id="3714293724629759655">Wbudowana w tę wersję</translation>
<translation id="4400672829102797741">Aktualizacje</translation>
<translation id="3764645718320810263">Codzienne aktualizacje są wyłączone</translation>
<translation id="3053476032032536111">Ostatnie sprawdzenie się nie udało. Przeglądarka spróbuje ponownie w ciągu godziny.</translation>
<translation id="6960448024325525076">Sprawdź teraz</translation>
<translation id="2258591756126042219">Sprawdzanie…</translation>
