# Copyright Plain Browser contributors. MPL-2.0.
# "Shields": the user-facing side of the protections. One per-site exception
# list (profile pref) honoured by adblock, tracking-parameter stripping and
# fingerprint protection, and the toolbar button + bubble that edits it.
import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojom") {
  sources = [ "common/shields.mojom" ]
}

source_set("common") {
  sources = [
    "common/pref_names.h",
    "common/site_util.cc",
    "common/site_util.h",
    "common/switches.h",
  ]
  deps = [
    "//base",
    "//net",
    "//url",
  ]
}

# The exception-list pref and its helpers. No //content, so unit tests link it
# alone (docs/TESTING.md).
source_set("prefs") {
  sources = [
    "browser/shields_prefs.cc",
    "browser/shields_prefs.h",
  ]
  public_deps = [ ":common" ]
  deps = [
    "//base",
    "//components/pref_registry",
    "//components/prefs",
    "//url",
  ]
}

source_set("browser") {
  sources = [
    "browser/blocked_requests_counter.cc",
    "browser/blocked_requests_counter.h",
    "browser/shields_service.cc",
    "browser/shields_service.h",
  ]
  public_deps = [
    ":common",
    ":mojom",
    ":prefs",
  ]
  deps = [
    "//base",
    "//components/prefs",
    "//components/user_prefs",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//third_party/blink/public/common",
  ]
}

source_set("renderer") {
  sources = [
    "renderer/shields_config_impl.cc",
    "renderer/shields_config_impl.h",
  ]
  public_deps = [ ":mojom" ]
  deps = [
    ":common",
    "//base",
    "//mojo/public/cpp/bindings",
  ]
}

# Toolbar button and bubble, and the strings of the settings section that lists
# the exceptions. Linked into chrome through //plainbrowser:browser
# (chrome/browser:browser depends on it); ToolbarView includes
# ui/shields_button.h and the settings strings provider
# ui/shields_settings_strings.h (patches/60-ui). Depends on //chrome/browser/ui
# for the toolbar and bubble base classes; that target does not depend on us,
# so there is no cycle. Strings: resources/plainbrowser_shields_strings.grdp,
# a part of chrome/app/generated_resources.grd (patches/60-ui/0008).
source_set("ui") {
  sources = [
    "ui/shields_bubble_view.cc",
    "ui/shields_bubble_view.h",
    "ui/shields_button.cc",
    "ui/shields_button.h",
    "ui/shields_settings_strings.cc",
    "ui/shields_settings_strings.h",
  ]
  deps = [
    ":browser",
    ":common",
    "//base",
    "//cc/paint",
    "//chrome/app:generated_resources",
    "//chrome/browser/ui",
    "//chrome/common",
    "//components/tabs:public",
    "//components/user_prefs",
    "//components/vector_icons",
    "//content/public/browser",
    "//skia",
    "//ui/base",
    "//ui/color",
    "//ui/gfx",
    "//ui/views",
  ]
}

# Part of //plainbrowser:plainbrowser_unittests (see docs/TESTING.md).
source_set("unit_tests") {
  testonly = true
  sources = [ "browser/shields_prefs_unittest.cc" ]
  deps = [
    ":prefs",
    "//base",
    "//components/prefs",
    "//components/prefs:test_support",
    "//testing/gmock",
    "//testing/gtest",
  ]
}
