import("//testing/test.gni")

# Chromium targets depend on //plainbrowser:browser and //plainbrowser:renderer
# (patches/00-build/0001-gn-deps.patch); each feature adds itself here.
group("browser") {
  public_deps = [
    "//plainbrowser/adblock:browser",
    "//plainbrowser/fingerprint:browser",
    "//plainbrowser/shields:browser",
    "//plainbrowser/shields:ui",
  ]
}

group("renderer") {
  public_deps = [
    "//plainbrowser/adblock:renderer",
    "//plainbrowser/fingerprint:renderer",
    "//plainbrowser/shields:renderer",
  ]
}

group("plainbrowser") {
  public_deps = [
    ":browser",
    ":renderer",
  ]
}

# gtest unit tests for our C++ code: ninja -C out\Default plainbrowser_unittests
# (reachable because chrome depends on //plainbrowser). Needs no //content: the
# features are split so the testable parts link alone; see docs/TESTING.md.
# //mojo/core/test:run_all_unittests initialises mojo for the filter tests.
test("plainbrowser_unittests") {
  deps = [
    "//mojo/core/test:run_all_unittests",
    "//plainbrowser/adblock:unit_tests",
    "//plainbrowser/fingerprint:unit_tests",
    "//plainbrowser/shields:unit_tests",
  ]
}
