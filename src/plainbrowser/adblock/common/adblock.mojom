module plainbrowser.adblock.mojom;

import "third_party/blink/public/mojom/tokens/tokens.mojom";
import "url/mojom/url.mojom";

// Browser-process ad/tracker filter, backed by adblock-rust. Exposed to
// renderer processes (see browser/renderer_interfaces.h).
interface AdblockFilter {
  // Adds another receiver; used to hand the filter to worker threads.
  Clone(pending_receiver<AdblockFilter> receiver);

  // `request_type` uses adblock-rust names: "script", "image", "stylesheet",
  // "font", "media", "sub_frame", "xmlhttprequest", "websocket", "object",
  // "other". `source_url` is the URL of the requesting document (or its origin).
  // `top_level_url` is the origin of the top-level frame of the page the
  // request belongs to (the per-site exception list is keyed by its site);
  // `frame_token` identifies the requesting frame so the browser can count
  // blocked requests per tab (absent for worker requests).
  ShouldBlockRequest(url.mojom.Url url, url.mojom.Url source_url,
                     string request_type, url.mojom.Url top_level_url,
                     blink.mojom.LocalFrameToken? frame_token) => (bool block);

  // Element-hiding CSS for a document URL; empty when nothing applies or the
  // site of `top_level_url` is on the exception list. `generic_hide` is true
  // when generic class/id rules do not apply to the document ($generichide,
  // the exception list, or no engine yet): the renderer then does not call
  // GetGenericCosmeticCss.
  // `procedural_actions` (adblock-rust action JSON) and `procedural_selectors`
  // (selectors with non-CSS operators) are for the renderer's isolated-world
  // script (renderer/cosmetic_script.js).
  GetCosmeticCss(url.mojom.Url url, url.mojom.Url top_level_url)
      => (string css, bool generic_hide, array<string> procedural_actions,
          array<string> procedural_selectors);

  // Sync: the scriptlets must run in the document's main world before any of
  // the page's scripts, so the renderer waits for them when the main world's
  // script context is created. Empty when none apply or the site is excepted.
  [Sync]
  GetScriptlets(url.mojom.Url url, url.mojom.Url top_level_url)
      => (string script);

  // Sync, once per renderer process (and again after a while): the hosts that
  // $redirect rules name. Only requests to them (or their subdomains) are
  // checked with GetRedirect.
  [Sync]
  GetRedirectHosts() => (array<string> hosts);

  // Sync, from the renderer hook that may still replace a request's URL
  // (ChromeContentRendererClient::WillSendRequest): a data: URL with the
  // replacement resource when a $redirect rule applies, else empty. Counted as
  // a blocked request for `frame_token`'s tab.
  [Sync]
  GetRedirect(url.mojom.Url url, url.mojom.Url source_url,
              url.mojom.Url top_level_url,
              blink.mojom.LocalFrameToken? frame_token)
      => (string data_url);

  // Generic element-hiding CSS for class names and ids found in the document
  // (only ones not sent before for that document). Empty when none of them has
  // a rule.
  GetGenericCosmeticCss(url.mojom.Url url, url.mojom.Url top_level_url,
                        array<string> classes, array<string> ids)
      => (string css);
};
