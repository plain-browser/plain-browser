import("//build/rust/rust_static_library.gni")
import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojom") {
  sources = [ "common/adblock.mojom" ]
  public_deps = [
    "//third_party/blink/public/mojom/tokens:tokens",
    "//url/mojom:url_mojom_gurl",
  ]
}

# adblock-rust behind a cxx bridge. Built by GN with Chromium's Rust toolchain
# (never as a cargo staticlib: that would bring a second Rust std/allocator).
# The adblock crate and its dependencies are vendored into
# //third_party/rust/chromium_crates_io by patches/30-adblock (generated with gnrt).
rust_static_library("ffi") {
  crate_name = "plainbrowser_adblock_ffi"
  crate_root = "rs/src/lib.rs"
  sources = [ "rs/src/lib.rs" ]
  inputs = [
    "lists/easylist.txt",
    "lists/easylistpolish.txt",
    "lists/easyprivacy.txt",
    "lists/plainbrowser-removeparam.txt",
  ]
  cxx_bindings = [ "rs/src/lib.rs" ]
  allow_unsafe = true
  edition = "2021"
  deps = [ "//third_party/rust/adblock/v0_13:lib" ]
  visibility = [ ":*" ]
}

# Engine owner and the pure navigation-throttle rules: no //content, so unit
# tests link them alone.
source_set("engine") {
  sources = [
    "browser/ad_block_service.cc",
    "browser/ad_block_service.h",
    "browser/tracking_params_rules.cc",
    "browser/tracking_params_rules.h",
  ]
  public_deps = [ ":ffi" ]
  deps = [
    "//base",
    "//url",
  ]
}

source_set("browser") {
  sources = [
    "browser/adblock_filter_impl.cc",
    "browser/adblock_filter_impl.h",
    "browser/renderer_interfaces.cc",
    "browser/renderer_interfaces.h",
    "browser/tracking_params_navigation_throttle.cc",
    "browser/tracking_params_navigation_throttle.h",
  ]
  public_deps = [
    ":engine",
    ":mojom",
    "//services/service_manager/public/cpp",
  ]
  deps = [
    "//base",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//plainbrowser/shields:browser",
    "//third_party/blink/public/common",
    "//url",
  ]
}

# The subresource throttle alone: needs only blink/public/common, so unit tests
# link it without the rest of Blink.
source_set("url_loader_throttle") {
  sources = [
    "renderer/adblock_url_loader_throttle.cc",
    "renderer/adblock_url_loader_throttle.h",
  ]
  public_deps = [ ":mojom" ]
  deps = [
    "//base",
    "//mojo/public/cpp/bindings",
    "//net",
    "//services/network/public/cpp",
    "//third_party/blink/public/common",
    "//url",
  ]
}

source_set("renderer") {
  sources = [
    "renderer/adblock_throttle_factory.cc",
    "renderer/adblock_throttle_factory.h",
    "renderer/cosmetic_filter_agent.cc",
    "renderer/cosmetic_filter_agent.h",
  ]
  public_deps = [
    ":mojom",
    ":url_loader_throttle",
  ]
  deps = [
    "//base",
    "//content/public/renderer",
    "//mojo/public/cpp/bindings",
    "//net",
    "//services/network/public/cpp",
    "//third_party/blink/public:blink",
    "//third_party/blink/public/common",
    "//url",
  ]
}
