import("//build/rust/rust_static_library.gni")
import("//mojo/public/tools/bindings/mojom.gni")

mojom("mojom") {
  sources = [ "common/adblock.mojom" ]
  public_deps = [
    "//third_party/blink/public/mojom/tokens:tokens",
    "//url/mojom:url_mojom_gurl",
  ]
}

# adblock-rust behind a cxx bridge. Built by GN with Chromium's Rust toolchain
# (never as a cargo staticlib: that would bring a second Rust std/allocator).
# The adblock crate and its dependencies are vendored into
# //third_party/rust/chromium_crates_io by patches/30-adblock (generated with gnrt).
rust_static_library("ffi") {
  crate_name = "plainbrowser_adblock_ffi"
  crate_root = "rs/src/lib.rs"
  sources = [
    "rs/src/lib.rs",
    "rs/src/resources.rs",
  ]
  inputs = [
    "lists/easylist.txt",
    "lists/easylistpolish.txt",
    "lists/easyprivacy.txt",
    "lists/plainbrowser-removeparam.txt",
    "resources/redirects/1x1.gif",
    "resources/redirects/2x2.png",
    "resources/redirects/chartbeat.js",
    "resources/redirects/fingerprint2.js",
    "resources/redirects/google-analytics_analytics.js",
    "resources/redirects/googlesyndication_adsbygoogle.js",
    "resources/redirects/googletagmanager_gtm.js",
    "resources/redirects/noop.css",
    "resources/redirects/noop.html",
    "resources/redirects/noop.js",
    "resources/redirects/noop.json",
    "resources/redirects/noop.txt",
    "resources/scriptlets/abort-current-script.js",
    "resources/scriptlets/abort-on-property-read.js",
    "resources/scriptlets/abort-on-property-write.js",
    "resources/scriptlets/abort-on-stack-trace.js",
    "resources/scriptlets/addEventListener-defuser.js",
    "resources/scriptlets/cookie-remover.js",
    "resources/scriptlets/json-prune.js",
    "resources/scriptlets/no-fetch-if.js",
    "resources/scriptlets/no-setInterval-if.js",
    "resources/scriptlets/no-setTimeout-if.js",
    "resources/scriptlets/no-xhr-if.js",
    "resources/scriptlets/pb-storage.fn.js",
    "resources/scriptlets/pb-timers.fn.js",
    "resources/scriptlets/pb-utils.fn.js",
    "resources/scriptlets/remove-attr.js",
    "resources/scriptlets/remove-class.js",
    "resources/scriptlets/remove-node-text.js",
    "resources/scriptlets/set-constant.js",
    "resources/scriptlets/set-cookie.js",
    "resources/scriptlets/set-local-storage-item.js",
    "resources/scriptlets/set-session-storage-item.js",
    "resources/scriptlets/window.open-defuser.js",
  ]
  cxx_bindings = [ "rs/src/lib.rs" ]
  allow_unsafe = true
  edition = "2021"
  deps = [ "//third_party/rust/adblock/v0_13:lib" ]
  visibility = [ ":*" ]
}

# Engine owner and the pure navigation-throttle rules: no //content, so unit
# tests link them alone.
source_set("engine") {
  sources = [
    "browser/ad_block_service.cc",
    "browser/ad_block_service.h",
    "browser/tracking_params_rules.cc",
    "browser/tracking_params_rules.h",
  ]
  public_deps = [ ":ffi" ]
  deps = [
    "//base",
    "//url",
  ]
}

# Downloaded filter lists: manifest parsing, verification and the copy in the
# profile directory. No network and no //content, so unit tests link it alone.
source_set("lists") {
  sources = [
    "browser/filter_lists.cc",
    "browser/filter_lists.h",
  ]
  deps = [
    "//base",
    "//crypto",
    "//third_party/boringssl",
    "//url",
  ]
}

# Daily list updates from lists.plain-browser.app. Started from
# ChromeBrowserMainParts and registered in Local State (patches/30-adblock/0006);
# needs only the network service client library, not //content.
source_set("updater") {
  sources = [
    "browser/filter_list_updater.cc",
    "browser/filter_list_updater.h",
    "common/pref_names.h",
  ]
  public_deps = [ ":lists" ]
  deps = [
    ":engine",
    "//base",
    "//components/prefs",
    "//net",
    "//net/traffic_annotation",
    "//plainbrowser/common:version",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//url",
  ]
}

source_set("browser") {
  sources = [
    "browser/adblock_filter_impl.cc",
    "browser/adblock_filter_impl.h",
    "browser/renderer_interfaces.cc",
    "browser/renderer_interfaces.h",
    "browser/tracking_params_navigation_throttle.cc",
    "browser/tracking_params_navigation_throttle.h",
  ]
  public_deps = [
    ":engine",
    ":mojom",
    "//services/service_manager/public/cpp",
  ]
  deps = [
    "//base",
    "//content/public/browser",
    "//mojo/public/cpp/bindings",
    "//plainbrowser/shields:browser",
    "//third_party/blink/public/common",
    "//url",
  ]
}

# The subresource throttle alone: needs only blink/public/common, so unit tests
# link it without the rest of Blink.
source_set("url_loader_throttle") {
  sources = [
    "renderer/adblock_url_loader_throttle.cc",
    "renderer/adblock_url_loader_throttle.h",
  ]
  public_deps = [ ":mojom" ]
  deps = [
    "//base",
    "//mojo/public/cpp/bindings",
    "//net",
    "//services/network/public/cpp",
    "//third_party/blink/public/common",
    "//url",
  ]
}

# cosmetic_script.js (procedural filters, DOM observer) as a C++ constant.
action("embed_cosmetic_script") {
  script = "//plainbrowser/fingerprint/renderer/embed_text.py"
  sources = [ "renderer/cosmetic_script.js" ]
  outputs = [ "$target_gen_dir/cosmetic_script.cc" ]
  args = [
    rebase_path(sources[0], root_build_dir),
    rebase_path(outputs[0], root_build_dir),
    "kCosmeticScript",
    "plainbrowser::adblock",
  ]
}

source_set("renderer") {
  sources = [
    "renderer/adblock_throttle_factory.cc",
    "renderer/adblock_throttle_factory.h",
    "renderer/cosmetic_filter_agent.cc",
    "renderer/cosmetic_filter_agent.h",
    "renderer/cosmetic_script.h",
    "renderer/request_redirector.cc",
    "renderer/request_redirector.h",
  ]
  sources += get_target_outputs(":embed_cosmetic_script")
  public_deps = [
    ":mojom",
    ":url_loader_throttle",
  ]
  deps = [
    ":embed_cosmetic_script",
    "//base",
    "//content/public/common",
    "//content/public/renderer",
    "//mojo/public/cpp/bindings",
    "//net",
    "//services/network/public/cpp",
    "//third_party/blink/public:blink",
    "//third_party/blink/public/common",
    "//url",
    "//v8",
  ]
}

# Part of //plainbrowser:plainbrowser_unittests (see docs/TESTING.md).
source_set("unit_tests") {
  testonly = true
  sources = [
    "browser/ad_block_service_unittest.cc",
    "browser/adblock_ffi_unittest.cc",
    "browser/filter_lists_unittest.cc",
    "browser/tracking_params_rules_unittest.cc",
    "renderer/adblock_url_loader_throttle_unittest.cc",
  ]
  deps = [
    ":engine",
    ":ffi",
    ":lists",
    ":mojom",
    ":url_loader_throttle",
    "//base",
    "//base/test:test_support",
    "//crypto",
    "//mojo/public/cpp/bindings",
    "//net",
    "//services/network/public/cpp",
    "//testing/gtest",
    "//third_party/blink/public/common",
    "//third_party/boringssl",
    "//url",
  ]
}
