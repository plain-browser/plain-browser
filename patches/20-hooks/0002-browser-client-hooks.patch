+    // Plain Browser: switches for our renderer features (patches/20-hooks).
+    plainbrowser::hooks::AppendRendererCommandLineSwitches(command_line,
+                                                           child_process_id);
     content::RenderProcessHost* process =
         content::RenderProcessHost::FromID(child_process_id);
     if (process) {
@@ -5735,6 +5742,8 @@
 void ChromeContentBrowserClient::CreateThrottlesForNavigation(
     content::NavigationThrottleRegistry& registry) {
   CreateAndAddChromeThrottlesForNavigation(registry);
+  // Plain Browser: our navigation throttles (patches/20-hooks).
