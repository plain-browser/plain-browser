 #include "chrome/chrome_elf/chrome_elf_constants.h"
+#include "chrome/chrome_elf/nt_registry/nt_registry.h"
 #include "chrome/install_static/install_util.h"
 #include "chrome/install_static/user_data_dir.h"
 #include "components/crash/core/app/crashpad.h"
 #include "components/metrics/system_profile_user_stream.h"
 #include "components/version_info/channel.h"
+#include "plainbrowser/crash/common/crash_constants.h"
 
 ChromeCrashReporterClient::ChromeCrashReporterClient() = default;
 
@@ -150,8 +152,25 @@
   return install_static::HasEnvironmentVariable(install_static::kHeadless);
 }
 
+// Plain Browser: uploads follow the user's "Send crash reports" choice
+// (//plainbrowser/crash, off by default), mirrored into the registry by
+// CrashConsent, not metrics consent. The MetricsReportingEnabled policy still
+// wins.
 bool ChromeCrashReporterClient::GetCollectStatsConsent() {
-  return install_static::GetCollectStatsConsent();
+  bool enabled = false;
+  if (install_static::ReportingIsEnforcedByPolicy(&enabled)) {
+    return enabled;
+  }
+  DWORD value = 0;
+  return nt::QueryRegValueDWORD(nt::HKCU, nt::WOW6432,
+                                install_static::GetRegistryPath().c_str(),
+                                plainbrowser::crash::kConsentRegValue,
+                                &value) &&
+         value == 1;
+}
+
+std::string ChromeCrashReporterClient::GetUploadUrl() {
+  return plainbrowser::crash::kUploadUrl;
 }
 
 bool ChromeCrashReporterClient::GetCollectStatsInSample() {
