From: Draftway
Subject: [adblock] Link //draftway/adblock into chrome/browser:core and chrome/renderer

Category: 30-adblock. Code lives in //draftway/adblock; this patch only wires it in.
---
--- a/chrome/browser/BUILD.gn
+++ b/chrome/browser/BUILD.gn
@@ -881,6 +881,7 @@
   }
 
   deps = [
+    "//draftway/adblock:browser",
     ":active_use_util",
     ":after_startup_task_utils",
     ":bad_message",
--- a/chrome/renderer/BUILD.gn
+++ b/chrome/renderer/BUILD.gn
@@ -126,6 +126,7 @@
   ]
 
   deps = [
+    "//draftway/adblock:renderer",
     ":process_state",
     "//base/allocator:buildflags",
     "//build:chromeos_buildflags",
