From: Plain Browser
Subject: [adblock] Add the Plain Browser adblock throttle to renderer subresource loads

Category: 30-adblock. Code lives in //plainbrowser/adblock; this patch only wires it in.
---
--- a/chrome/renderer/url_loader_throttle_provider_impl.cc
+++ b/chrome/renderer/url_loader_throttle_provider_impl.cc
@@ -117,7 +117,7 @@
       pending_extension_web_request_reporter.InitWithNewPipeAndPassReceiver());
 #endif  // BUILDFLAG(ENABLE_EXTENSIONS)
 
-  return std::make_unique<URLLoaderThrottleProviderImpl>(
+  auto provider = std::make_unique<URLLoaderThrottleProviderImpl>(
       type, chrome_content_renderer_client, std::move(pending_safe_browsing),
 #if BUILDFLAG(ENABLE_EXTENSIONS)
       std::move(pending_extension_web_request_reporter),
@@ -127,6 +127,9 @@
           ? base::SequencedTaskRunner::GetCurrentDefault()
           : nullptr,
       base::PassKey<URLLoaderThrottleProviderImpl>());
+  provider->plainbrowser_adblock_ =
+      plainbrowser::adblock::AdblockThrottleFactory::Create(broker);
+  return provider;
 }
 
 URLLoaderThrottleProviderImpl::URLLoaderThrottleProviderImpl(
@@ -158,12 +161,16 @@
 std::unique_ptr<blink::URLLoaderThrottleProvider>
 URLLoaderThrottleProviderImpl::Clone() {
   DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
-  return std::make_unique<URLLoaderThrottleProviderImpl>(
+  auto clone = std::make_unique<URLLoaderThrottleProviderImpl>(
       type_, chrome_content_renderer_client_, CloneSafeBrowsingPendingRemote(),
 #if BUILDFLAG(ENABLE_EXTENSIONS)
       CloneExtensionWebRequestReporterPendingRemote(),
 #endif  // BUILDFLAG(ENABLE_EXTENSIONS)
       main_thread_task_runner_, base::PassKey<URLLoaderThrottleProviderImpl>());
+  if (plainbrowser_adblock_) {
+    clone->plainbrowser_adblock_ = plainbrowser_adblock_->Clone();
+  }
+  return clone;
 }
 
 std::vector<std::unique_ptr<blink::URLLoaderThrottle>>
@@ -191,6 +198,13 @@
 
   DCHECK(!is_frame_resource ||
          type_ == blink::URLLoaderThrottleProviderType::kFrame);
+
+  // Plain Browser adblock: subresources only (returns null for frame resources).
+  if (plainbrowser_adblock_) {
+    if (auto throttle = plainbrowser_adblock_->MaybeCreateThrottle(request)) {
+      throttles.emplace_back(std::move(throttle));
+    }
+  }
 
 #if BUILDFLAG(SAFE_BROWSING_AVAILABLE)
   if (!is_frame_resource) {
--- a/chrome/renderer/url_loader_throttle_provider_impl.h
+++ b/chrome/renderer/url_loader_throttle_provider_impl.h
@@ -17,6 +17,8 @@
 #include "mojo/public/cpp/bindings/remote.h"
 #include "third_party/blink/public/common/thread_safe_browser_interface_broker_proxy.h"
 #include "third_party/blink/public/platform/url_loader_throttle_provider.h"
+
+#include "plainbrowser/adblock/renderer/adblock_throttle_factory.h"
 
 #if BUILDFLAG(ENABLE_EXTENSIONS_CORE)
 #include "extensions/renderer/extension_throttle_manager.h"
@@ -95,6 +97,9 @@
   // provider which was created on the main thread.
   scoped_refptr<base::SequencedTaskRunner> main_thread_task_runner_;
 
+  // Plain Browser adblock; null when the filter interface is unavailable.
+  std::unique_ptr<plainbrowser::adblock::AdblockThrottleFactory> plainbrowser_adblock_;
+
   SEQUENCE_CHECKER(sequence_checker_);
 };
 
