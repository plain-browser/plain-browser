From: Plain Browser
Subject: [adblock] Add the Plain Browser adblock throttle to renderer subresource loads

Category: 30-adblock. Code lives in //plainbrowser/adblock; this patch only wires it in.
AdblockThrottleProvider (adblock/renderer) wraps the provider chrome creates and puts the adblock
throttle first in the throttles of every subresource request; Clone() wraps the clone, so worker
threads and background resource fetch are covered. URLLoaderThrottleProviderImpl itself is not
edited. The frame token the provider gets lets the throttle tell the browser the page's top-level
origin (per-site exceptions) and which tab the request belongs to (blocked-request counter).
---
--- a/chrome/renderer/chrome_content_renderer_client.cc
+++ b/chrome/renderer/chrome_content_renderer_client.cc
@@ -3,6 +3,10 @@
 // found in the LICENSE file.
 
 #include "chrome/renderer/chrome_content_renderer_client.h"
+
+// Plain Browser: own includes (patches/series), kept together up here so that
+// changes to the upstream include list below never touch this hunk.
+#include "plainbrowser/adblock/renderer/adblock_throttle_provider.h"
 
 #include <functional>
 #include <memory>
@@ -1658,8 +1662,12 @@
 std::unique_ptr<blink::URLLoaderThrottleProvider>
 ChromeContentRendererClient::CreateURLLoaderThrottleProvider(
     blink::URLLoaderThrottleProviderType provider_type) {
-  return URLLoaderThrottleProviderImpl::Create(provider_type, this,
-                                               browser_interface_broker_.get());
+  // Plain Browser: the adblock throttle goes in front of chrome's throttles
+  // for every subresource request (patches/30-adblock/0003).
+  return plainbrowser::adblock::AdblockThrottleProvider::Wrap(
+      URLLoaderThrottleProviderImpl::Create(provider_type, this,
+                                            browser_interface_broker_.get()),
+      browser_interface_broker_.get());
 }
 
 blink::WebFrame* ChromeContentRendererClient::FindFrame(
