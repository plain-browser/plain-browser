From: Plain Browser
Subject: [adblock] Add the tracking-parameter navigation throttle

Category: 30-adblock. Code lives in //plainbrowser/adblock; this patch only wires it in.
Frame navigations get TrackingParamsNavigationThrottle, which re-issues a navigation whose URL
carries $removeparam parameters (utm_*, fbclid, gclid, ...) with the clean URL.
---
--- a/chrome/browser/chrome_content_browser_client.cc
+++ b/chrome/browser/chrome_content_browser_client.cc
@@ -3,6 +3,10 @@
 // found in the LICENSE file.
 
 #include "chrome/browser/chrome_content_browser_client.h"
+
+// Plain Browser: own includes (patches/series), kept together up here so that
+// changes to the upstream include list below never touch this hunk.
+#include "plainbrowser/adblock/browser/tracking_params_navigation_throttle.h"
 
 #include <algorithm>
 #include <iterator>
@@ -5735,6 +5739,9 @@
 void ChromeContentBrowserClient::CreateThrottlesForNavigation(
     content::NavigationThrottleRegistry& registry) {
   CreateAndAddChromeThrottlesForNavigation(registry);
+  // Plain Browser: strip tracking parameters from navigations.
+  plainbrowser::adblock::TrackingParamsNavigationThrottle::MaybeCreateAndAdd(
+      registry);
 }
 
