From: Plain Browser
Subject: [adblock] Filter list updates: register the Local State prefs and start the updater

Category: 30-adblock. Code lives in //plainbrowser/adblock (FilterListUpdater, filter_lists); this patch only
wires it in. RegisterLocalState registers the adblock Local State prefs (FilterListUpdater::RegisterLocalStatePrefs);
ChromeBrowserMainParts::PostBrowserStart starts the updater with Local State, the browser process's shared URL
loader factory and the user data directory. It loads the lists stored by an earlier update at once and checks
lists.plain-browser.app for new ones once a day. //plainbrowser/adblock:updater is linked through
//plainbrowser:browser (00-build).
---
--- a/chrome/browser/chrome_browser_main.cc
+++ b/chrome/browser/chrome_browser_main.cc
@@ -3,6 +3,10 @@
 // found in the LICENSE file.
 
 #include "chrome/browser/chrome_browser_main.h"
+
+// Plain Browser: own includes (patches/series), kept together up here so that
+// changes to the upstream include list below never touch this hunk.
+#include "plainbrowser/adblock/browser/filter_list_updater.h"
 
 #include <memory>
 #include <string>
@@ -1731,6 +1735,11 @@
 
   browser_process_->browser_policy_connector()->OnBrowserStarted();
 
+  // Plain Browser: daily filter list updates; loads the stored lists now.
+  plainbrowser::adblock::FilterListUpdater::Start(
+      browser_process_->local_state(),
+      browser_process_->shared_url_loader_factory(), user_data_dir_);
+
 #if BUILDFLAG(ENABLE_PROCESS_SINGLETON)
   // Allow ProcessSingleton to process messages.
   // This is done here instead of just relying on the main message loop's start
--- a/chrome/browser/prefs/browser_prefs.cc
+++ b/chrome/browser/prefs/browser_prefs.cc
@@ -3,6 +3,10 @@
 // found in the LICENSE file.
 
 #include "chrome/browser/prefs/browser_prefs.h"
+
+// Plain Browser: own includes (patches/series), kept together up here so that
+// changes to the upstream include list below never touch this hunk.
+#include "plainbrowser/adblock/browser/filter_list_updater.h"
 
 #include <array>
 #include <optional>
@@ -1658,6 +1662,8 @@
   // Call outs to individual subsystems that register Local State (browser-wide)
   // prefs en masse. See RegisterProfilePrefs for per-profile prefs. Please
   // keep this list alphabetized.
+  // Plain Browser: filter list updates (on/off, last check).
+  plainbrowser::adblock::FilterListUpdater::RegisterLocalStatePrefs(registry);
 #if BUILDFLAG(IS_ANDROID)
   accessibility::AccessibilityPrefsController::RegisterLocalStatePrefs(
       registry);
