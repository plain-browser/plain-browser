From: Plain Browser
Subject: [adblock] Expose plainbrowser.adblock.mojom.AdblockFilter to renderers

Category: 30-adblock. Code lives in //plainbrowser/adblock; this patch only wires it in.
The render process host is passed along: the filter uses its id to count blocked requests per tab.
(The ShieldsConfig binding of //plainbrowser/shields for the same process is 60-ui/0007.)
---
--- a/chrome/browser/chrome_content_browser_client_receiver_bindings.cc
+++ b/chrome/browser/chrome_content_browser_client_receiver_bindings.cc
@@ -1,6 +1,10 @@
 // Copyright 2019 The Chromium Authors
 // Use of this source code is governed by a BSD-style license that can be
 // found in the LICENSE file.
+
+// Plain Browser: own includes (patches/series), kept together up here so that
+// changes to the upstream include list below never touch this hunk.
+#include "plainbrowser/adblock/browser/renderer_interfaces.h"
 
 // This file exposes services from the browser to child processes.
 
@@ -239,6 +243,10 @@
   registry->AddInterface<metrics::mojom::CallStackProfileCollector>(
       base::BindRepeating(&metrics::CallStackProfileCollector::Create));
 
+  // Plain Browser: adblock filter for renderer subresource and cosmetic
+  // filtering (patches/30-adblock/0002).
+  plainbrowser::adblock::ExposeInterfacesToRenderer(registry, render_process_host);
+
   if (NetBenchmarking::CheckBenchmarkingEnabled()) {
     Profile* profile =
         Profile::FromBrowserContext(render_process_host->GetBrowserContext());
