From: Plain Browser
Subject: [fingerprint] Pass the fingerprint session key and exceptions to renderers

The exceptions are the --fingerprint-exceptions switch and, as --plainbrowser-shields-exceptions,
the profile's per-site exception list (prefs::kShieldsExceptions) looked up through the renderer's
process id: the initial value of the renderer's ShieldsConfig list.

Category: 80-fingerprint. Code lives in //plainbrowser/fingerprint; this patch only wires it in.
Applies after 30-adblock/0005 (same include block).
---
--- a/chrome/browser/chrome_content_browser_client.cc
+++ b/chrome/browser/chrome_content_browser_client.cc
@@ -7,6 +7,7 @@
 // Plain Browser: own includes (patches/series), kept together up here so that
 // changes to the upstream include list below never touch this hunk.
 #include "plainbrowser/adblock/browser/tracking_params_navigation_throttle.h"
+#include "plainbrowser/fingerprint/browser/renderer_switches.h"
 
 #include <algorithm>
 #include <iterator>
@@ -3162,6 +3163,9 @@
 #endif
 
   if (process_type == switches::kRendererProcess) {
+    // Plain Browser: fingerprint session key and exception list.
+    plainbrowser::fingerprint::AppendRendererCommandLineSwitches(command_line,
+                                                                 child_process_id);
     content::RenderProcessHost* process =
         content::RenderProcessHost::FromID(child_process_id);
     if (process) {
