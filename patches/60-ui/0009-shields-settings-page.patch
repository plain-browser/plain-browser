+// Copyright Plain Browser contributors. MPL-2.0.
+
+/**
+ * @fileoverview
+ * 'settings-plainbrowser-shields-exceptions' lists the sites on which Plain
+ * Browser's protections (ad blocking, tracking-parameter stripping,
+ * fingerprint protection) are off: pref plainbrowser.shields.exceptions, the
+ * list the toolbar bubble edits (//plainbrowser/shields). Entries are stored as
+ * typed; the browser rewrites them as sites (eTLD+1), so
+ * "https://www.example.com/a" shows up as "example.com" a moment later.
+ */
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import 'chrome://resources/cr_elements/cr_hidden_style.css.js';
+import 'chrome://resources/cr_elements/cr_icon_button/cr_icon_button.js';
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import 'chrome://resources/cr_elements/cr_shared_style.css.js';
+import '../settings_shared.css.js';
+
+import {PrefsMixin} from '/shared/settings/prefs/prefs_mixin.js';
+import type {CrButtonElement} from 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import type {CrDialogElement} from 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import {I18nMixin} from 'chrome://resources/cr_elements/i18n_mixin.js';
+import {focusWithoutInk} from 'chrome://resources/js/focus_without_ink.js';
+import type {DomRepeatEvent} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+import {PolymerElement} from 'chrome://resources/polymer/v3_0/polymer/polymer_bundled.min.js';
+
+import {getTemplate} from './plainbrowser_shields_exceptions.html.js';
+
+const EXCEPTIONS_PREF = 'plainbrowser.shields.exceptions';
+
+/**
+ * The host named by what the user typed in the add dialog ("example.com",
+ * "www.example.com", "https://example.com/path"), or '' when the text is not
+ * an http(s) address.
+ */
+export function hostFromInput(text: string): string {
+  const trimmed = text.trim();
+  if (!trimmed || /\s/.test(trimmed)) {
+    return '';
+  }
+  try {
+    const url =
+        new URL(trimmed.includes('://') ? trimmed : `https://${trimmed}`);
+    if (url.protocol !== 'https:' && url.protocol !== 'http:') {
+      return '';
+    }
+    return url.hostname;
+  } catch {
+    return '';
+  }
+}
+
+export interface SettingsPlainBrowserShieldsExceptionsElement {
+  $: {
+    addSite: CrButtonElement,
+  };
+}
+
+const SettingsPlainBrowserShieldsExceptionsElementBase =
+    I18nMixin(PrefsMixin(PolymerElement));
+
+export class SettingsPlainBrowserShieldsExceptionsElement extends
+    SettingsPlainBrowserShieldsExceptionsElementBase {
+  static get is() {
+    return 'settings-plainbrowser-shields-exceptions';
+  }
+
+  static get template() {
+    return getTemplate();
+  }
+
+  static get properties() {
+    return {
+      sites_: {
+        type: Array,
+        computed:
+            'computeSites_(prefs.plainbrowser.shields.exceptions.value.*)',
+      },
+      showDialog_: {type: Boolean, value: false},
+      input_: {type: String, value: ''},
+      invalid_: {type: Boolean, value: false},
+    };
+  }
+
+  declare private sites_: string[];
+  declare private showDialog_: boolean;
+  declare private input_: string;
+  declare private invalid_: boolean;
+
+  private computeSites_(): string[] {
+    const pref = this.getPref<unknown[]>(EXCEPTIONS_PREF);
+    return Array.isArray(pref.value) ?
+        pref.value.filter((s): s is string => typeof s === 'string') :
+        [];
+  }
+
+  private hasSites_(): boolean {
+    return !!this.sites_ && this.sites_.length > 0;
+  }
+
+  private removeLabel_(site: string): string {
+    return this.i18n('plainBrowserShieldsRemove', site);
+  }
+
+  private onRemoveClick_(e: DomRepeatEvent<string>) {
+    this.deletePrefListItem(EXCEPTIONS_PREF, e.model.item);
+  }
+
+  private onAddClick_() {
+    this.input_ = '';
+    this.invalid_ = false;
+    this.showDialog_ = true;
+  }
+
+  private onInput_() {
+    this.invalid_ = false;
+  }
+
+  private onConfirmClick_() {
+    const host = hostFromInput(this.input_);
+    if (!host) {
+      this.invalid_ = true;
+      return;
+    }
+    this.appendPrefListItem(EXCEPTIONS_PREF, host);
+    this.closeDialog_();
+  }
+
+  private onCancelClick_() {
+    this.closeDialog_();
+  }
+
+  private closeDialog_() {
+    this.shadowRoot!.querySelector<CrDialogElement>('#dialog')!.close();
+  }
+
+  private onDialogClose_() {
+    this.showDialog_ = false;
+    focusWithoutInk(this.$.addSite);
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-plainbrowser-shields-exceptions':
+        SettingsPlainBrowserShieldsExceptionsElement;
+  }
+}
+
+customElements.define(
+    SettingsPlainBrowserShieldsExceptionsElement.is,
+    SettingsPlainBrowserShieldsExceptionsElement);
