+// Copyright Plain Browser contributors. MPL-2.0.
+
+/**
+ * @fileoverview
+ * 'settings-plainbrowser-shields-exceptions' lists the sites on which Plain
+ * Browser's protections (ad blocking, tracking-parameter stripping,
+ * fingerprint protection) are off: pref plainbrowser.shields.exceptions, the
+ * list the toolbar bubble edits (//plainbrowser/shields). Entries are stored as
+ * typed; the browser rewrites them as sites (eTLD+1), so
+ * "https://www.example.com/a" shows up as "example.com" a moment later.
+ * Above the list, the global ad and tracker blocking toggle (Local State pref
+ * plainbrowser.adblock.enabled); below it, the toggle for daily filter list
+ * updates (plainbrowser.adblock.list_updates.enabled, FilterListUpdater), when
+ * the lists were last checked (plainbrowser.adblock.list_updates.last_success,
+ * ms since the epoch) and a link to chrome://adblock. Under the blocking
+ * toggle, the optional filter lists (plainbrowser.adblock.lists.*); at the end
+ * a link to chrome://recommended-extensions.
+ *
+ * A Lit element, like the privacy page around it: the settings prefs live in
+ * PrefService (one cache, observed by key).
+ */
+import 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import 'chrome://resources/cr_elements/cr_icon_button/cr_icon_button.js';
+import 'chrome://resources/cr_elements/cr_input/cr_input.js';
+import 'chrome://resources/cr_elements/cr_link_row/cr_link_row.js';
+import '../controls/settings_toggle_button.js';
+
+import {PrefService} from '/shared/settings/prefs2/pref_service.js';
+import {PrefServiceObserverMixinLit} from '/shared/settings/prefs2/pref_service_observer_mixin_lit.js';
+import type {CrButtonElement} from 'chrome://resources/cr_elements/cr_button/cr_button.js';
+import type {CrDialogElement} from 'chrome://resources/cr_elements/cr_dialog/cr_dialog.js';
+import {getCss as getCrHiddenStyleCss} from 'chrome://resources/cr_elements/cr_hidden_style_lit.css.js';
+import {getCss as getCrSharedStyleCss} from 'chrome://resources/cr_elements/cr_shared_style_lit.css.js';
+import {I18nMixinLit} from 'chrome://resources/cr_elements/i18n_mixin_lit.js';
+import {focusWithoutInk} from 'chrome://resources/js/focus_without_ink.js';
+import {OpenWindowProxyImpl} from 'chrome://resources/js/open_window_proxy.js';
+import {CrLitElement} from 'chrome://resources/lit/v3_0/lit.rollup.js';
+
+import {getCss as getSettingsSharedCss} from '../settings_shared_lit.css.js';
+
+import {getHtml} from './plainbrowser_shields_exceptions.html.js';
+
+const EXCEPTIONS_PREF = 'plainbrowser.shields.exceptions';
+const LAST_SUCCESS_PREF = 'plainbrowser.adblock.list_updates.last_success';
+const LIST_UPDATES_PREF = 'plainbrowser.adblock.list_updates.enabled';
+
+/**
+ * The host named by what the user typed in the add dialog ("example.com",
+ * "www.example.com", "https://example.com/path"), or '' when the text is not
+ * an http(s) address.
+ */
+export function hostFromInput(text: string): string {
+  const trimmed = text.trim();
+  if (!trimmed || /\s/.test(trimmed)) {
+    return '';
+  }
+  try {
+    const url =
+        new URL(trimmed.includes('://') ? trimmed : `https://${trimmed}`);
+    if (url.protocol !== 'https:' && url.protocol !== 'http:') {
+      return '';
+    }
+    return url.hostname;
+  } catch {
+    return '';
+  }
+}
+
+export interface PlainbrowserShieldsExceptionsElement {
+  $: {
+    addSite: CrButtonElement,
+  };
+}
+
+const PlainbrowserShieldsExceptionsElementBase =
+    I18nMixinLit(PrefServiceObserverMixinLit(CrLitElement));
+
+export class PlainbrowserShieldsExceptionsElement extends
+    PlainbrowserShieldsExceptionsElementBase {
+  static get is() {
+    return 'settings-plainbrowser-shields-exceptions';
+  }
+
+  static override get styles() {
+    return [
+      getCrSharedStyleCss(),
+      getCrHiddenStyleCss(),
+      getSettingsSharedCss(),
+    ];
+  }
+
+  override render() {
+    return getHtml.bind(this)();
+  }
+
+  static override get properties() {
+    return {
+      sites_: {type: Array},
+      lastCheckText_: {type: String},
+      listUpdatesEnabled_: {type: Boolean},
+      showDialog_: {type: Boolean},
+      input_: {type: String},
+      invalid_: {type: Boolean},
+    };
+  }
+
+  protected accessor sites_: string[] = [];
+  protected accessor lastCheckText_: string = '';
+  protected accessor listUpdatesEnabled_: boolean = false;
+  protected accessor showDialog_: boolean = false;
+  protected accessor input_: string = '';
+  protected accessor invalid_: boolean = false;
+
+  override connectedCallback() {
+    super.connectedCallback();
+    this.addPrefObserver<unknown[]>(EXCEPTIONS_PREF, pref => {
+      this.sites_ = Array.isArray(pref.value) ?
+          pref.value.filter((s): s is string => typeof s === 'string') :
+          [];
+    });
+    this.addPrefObserver<number>(LAST_SUCCESS_PREF, pref => {
+      this.lastCheckText_ = this.computeLastCheck_(pref.value);
+    });
+    this.addPrefObserver<boolean>(LIST_UPDATES_PREF, pref => {
+      this.listUpdatesEnabled_ = pref.value;
+    });
+  }
+
+  private computeLastCheck_(ms: number|undefined): string {
+    if (!ms) {
+      return this.i18n('plainBrowserListNeverChecked');
+    }
+    const when = new Intl.DateTimeFormat(
+                     document.documentElement.lang || undefined,
+                     {dateStyle: 'medium', timeStyle: 'short'})
+                     .format(new Date(ms));
+    return this.i18n('plainBrowserListLastCheck', when);
+  }
+
+  protected onStatusClick_() {
+    OpenWindowProxyImpl.getInstance().openUrl('chrome://adblock');
+  }
+
+  protected onExtensionsClick_() {
+    OpenWindowProxyImpl.getInstance().openUrl(
+        'chrome://recommended-extensions');
+  }
+
+  protected removeLabel_(site: string): string {
+    return this.i18n('plainBrowserShieldsRemove', site);
+  }
+
+  protected onRemoveClick_(e: Event) {
+    const site = (e.currentTarget as HTMLElement).dataset['site'];
+    PrefService.getInstance().setPrefValue(
+        EXCEPTIONS_PREF, this.sites_.filter(s => s !== site));
+  }
+
+  protected onAddClick_() {
+    this.input_ = '';
+    this.invalid_ = false;
+    this.showDialog_ = true;
+  }
+
+  protected onInputValueChanged_(e: CustomEvent<{value: string}>) {
+    this.input_ = e.detail.value;
+    this.invalid_ = false;
+  }
+
+  protected onConfirmClick_() {
+    const host = hostFromInput(this.input_);
+    if (!host) {
+      this.invalid_ = true;
+      return;
+    }
+    PrefService.getInstance().appendPrefListItem(EXCEPTIONS_PREF, host);
+    this.closeDialog_();
+  }
+
+  protected onCancelClick_() {
+    this.closeDialog_();
+  }
+
+  private closeDialog_() {
+    this.shadowRoot.querySelector<CrDialogElement>('#dialog')!.close();
+  }
+
+  protected onDialogClose_() {
+    this.showDialog_ = false;
+    focusWithoutInk(this.$.addSite);
+  }
+}
+
+declare global {
+  interface HTMLElementTagNameMap {
+    'settings-plainbrowser-shields-exceptions':
+        PlainbrowserShieldsExceptionsElement;
+  }
+}
+
+customElements.define(
+    PlainbrowserShieldsExceptionsElement.is,
+    PlainbrowserShieldsExceptionsElement);
